# Copy to .env and edit. Placeholders only - never commit real credentials.

# --- PostgreSQL (docker-compose.yml reads these) ---
POSTGRES_USER=dfs_admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=demand_forecast
POSTGRES_PORT=5433

# Read/write connection used by ingestion, training and persistence commands
DATABASE_URL=postgresql://dfs_admin:change-me-admin@localhost:5433/demand_forecast

# Read-only role used by the API (created by `dfs db-init`)
READONLY_DB_USER=dfs_readonly
READONLY_DB_PASSWORD=change-me-readonly
DATABASE_URL_READONLY=postgresql://dfs_readonly:change-me-readonly@localhost:5433/demand_forecast

# --- API ---
# Comma-separated list of browser origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend (frontend/.env.local) ---
# NEXT_PUBLIC_API_URL=http://localhost:8000
